# Server Environment Template
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# Database
DATABASE_URL=""

# Authentication (Must match client)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Redis
REDIS_URL="redis://localhost:6379"
LOCAL_REDIS_URL="redis://localhost:6379"

# Object Storage (MinIO)
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="youtube-videos"
PUBLIC_MINIO_URL="http://localhost:9000"

# WebSocket
PUBLIC_WS_URL="ws://localhost:4000"

# Upload & Job Settings
PRESIGNED_URL_EXPIRY=3600
DOWNLOAD_TIMEOUT_MS=7200000
JOB_LOCK_DURATION_MS=14400000
FILE_WAIT_TIMEOUT_MS=1800000
MAX_TEMP_AGE_MS=28800000
CLEANUP_INTERVAL_MS=900000
PROGRESS_THROTTLE_MS=5000

# Worker configuration
TRANSCODER_CONCURRENCY=2
TRANSCODER_RETRIES=3
NODE_ID="dev-worker-1"
TEMP_DIR="/tmp/transcoder"
HW_ACCEL="none"
