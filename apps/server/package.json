{
    "name": "@youtube/server",
    "version": "1.0.0",
    "private": true,
    "main": "dist/src/index.js",
    "types": "src/trpc/router.ts",
    "scripts": {
        "dev": "concurrently -c \"cyan,magenta\" -n \"api,worker\" \"nodemon src/index.ts\" \"tsx watch src/worker-entry.ts\"",
        "dev:cluster": "concurrently -c \"cyan,magenta\" -n \"api-cluster,worker\" \"CLUSTER_MODE=true nodemon src/index.ts\" \"tsx watch src/worker-entry.ts\"",
        "dev:api": "nodemon src/index.ts",
        "worker:dev": "tsx watch src/worker-entry.ts",
        "worker:transcode": "WORKER_TYPE=transcode tsx watch src/worker-entry.ts",
        "worker:engagement": "WORKER_TYPE=engagement tsx watch src/worker-entry.ts",
        "build": "tsc",
        "start": "node dist/src/index.js",
        "start:api": "node dist/src/index.js",
        "start:transcode": "WORKER_TYPE=transcode node dist/src/worker-entry.js",
        "start:services": "WORKER_TYPE=services node dist/src/worker-entry.js",
        "worker:start": "node dist/src/worker-entry.js"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.975.0",
        "@aws-sdk/lib-storage": "^3.975.0",
        "@aws-sdk/s3-request-presigner": "^3.975.0",
        "@prisma/adapter-pg": "^7.3.0",
        "@prisma/client": "^7.3.0",
        "@trpc/server": "^11.9.0",
        "bcryptjs": "^3.0.3",
        "better-auth": "^1.4.15",
        "bullmq": "^5.67.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "fluent-ffmpeg": "^2.1.3",
        "helmet": "^8.1.0",
        "ioredis": "^5.9.2",
        "node-cron": "^4.2.1",
        "pg": "^8.18.0",
        "superjson": "^2.2.6",
        "uuid": "^13.0.0",
        "ws": "^8.19.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/fluent-ffmpeg": "^2.1.28",
        "@types/node": "^25.0.10",
        "@types/node-cron": "^3.0.11",
        "@types/pg": "^8.16.0",
        "@types/uuid": "^11.0.0",
        "@types/ws": "^8.18.1",
        "concurrently": "^9.2.1",
        "nodemon": "^3.1.0",
        "prisma": "^7.3.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.19.2",
        "typescript": "^5"
    }
}
